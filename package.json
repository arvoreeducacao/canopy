    "url": "git+https://github.com/arvoreeducacao/canopy.git"
  },
  "bugs": {
    "url": "https://github.com/arvoreeducacao/canopy/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cdp",
    "chrome-devtools-protocol",
    "browser-automation",
    "ai-agent",
    "claude-code",
    "arc",
    "chrome-extension"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "canopy": "bin/canopy.js"
  },
